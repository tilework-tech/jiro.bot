    },
    {
      "what": "× close button and hide-for-tab",
      "why": "Interactive control; the video equivalent is simply not rendering him."
    },
    {
      "what": "Click-to-speak, ask line with Yes/Later buttons",
      "why": "Needs clicks. Lines come from the --lines file instead."
    },
    {
      "what": "Hover o_o face",
      "why": "No pointer. o_o stays as a resting expression."
    },
    {
      "what": "Dashed salmon outline on the glance target",
      "why": "Would draw onto the footage, which is outside Jiro's overlay. The 3px face shift stays."
    },
    {
      "what": "Screen-reader live region",
      "why": "No DOM. Burn captions separately if needed."
    },
    {
      "what": "Quiet mode reset by click; 'long pass' counter",
      "why": "No clicks and no scrolling. Replaced by quiet_after_lines per video type."
    },
    {
      "what": "Phone layout (56px mascot, phone anchors)",
      "why": "Size is set by --mascot-height instead; portrait frames drop the centre-band rule, as phones did."
    },
    {
      "what": "Reduced-motion variant",
      "why": "A rendered clip has no user preference; render with --type explainer for the calmest result."
    },
    {
      "what": "The small gesture played during a relocation",
      "why": "A relocation in video is a fade with no travel, so the gesture would play at a spot he has just left. Small moves play at rest only."
    }
